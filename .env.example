# Ollama / Local Models
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_MODEL=gemma2:2b

# Task Iterations
MAX_ITERATIONS=3

# Optional Cloud API Keys
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# Decision Router Engine (e.g. laya_heuristic, deepseek_tool, local_grunt)
ROUTER_ENGINE=laya_heuristic

# File Viewer Exclude / Ignore Patterns (comma-separated globs for directories/files to ignore in file explorer and zip archives)
FILE_VIEWER_IGNORE_PATTERNS=__pycache__,*.pyc,venv,.venv,node_modules,.git,.DS_Store,.pytest_cache,*.egg-info
